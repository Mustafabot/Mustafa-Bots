{
  "name": "mgpbot",
  "version": "1.0.0",
  "description": "MustafaKemalBot for MoegirlPedia",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json && tsc --noEmit -p src/gui/tsconfig.json && tsc --noEmit -p src/gui/tsconfig.test.json",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:unit": "node --import tsx --test \"src/**/*.test.ts\"",
    "gui": "tsx src/server/index.ts",
    "build:gui": "npm --prefix src/gui run build",
    "dev:gui": "concurrently -n server,vite -c blue,green \"tsx src/server/index.ts\" \"npm --prefix src/gui run dev\""
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bhsd/nodejs": "^1.0.0",
    "dotenv": "^16.6.1",
    "wiki-saikou": "^7.6.0",
    "wikiparser-node": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-jsdoc": "^65.4.5",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "tsx": "^4.23.15",
    "types-mediawiki-response": "^1.2.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2"
  }
}
